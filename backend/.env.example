# Groq API (https://console.groq.com/) — required
GROQ_API_KEY=your_groq_api_key_here

# OpenAI-compatible Groq endpoint + model
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# Stay under Groq on_demand RPM (llama-3.3-70b-versatile free tier = 30)
GROQ_RPM=30

# GoT defaults (paper uses Generate k=3 / Aggregate k=10; we default lower for demo cost)
GOT_DEFAULT_NUMBERS=48
GOT_CHUNK_SIZE=8
GOT_GENERATE_K=2
GOT_AGGREGATE_K=2

# Optional — mirror GoT events to Supabase (Table Editor → got_events)
# Create a project, run supabase/schema.sql, then paste:
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Optional: service role (backend only). If set, used instead of anon.
# SUPABASE_SERVICE_ROLE_KEY=
